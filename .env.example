# Copy this file to .env and edit it. Nothing else needs to change.
#
#   cp .env.example .env
#
# .env is git-ignored, so your real keys never get committed.
# Keep values plain: no quotes, and no '#' inside a value.

# --- What Chorus connects to -------------------------------------------
# These URLs are used by the Chorus worker, which runs in a container.
# 'localhost' there means the container itself, so use a real hostname or
# IP. On a Mac, a server running on your laptop is host.docker.internal.
# The lab defaults are the container names of minio-a and minio-b.

SOURCE_URL=http://minio-a:9000
SOURCE_ACCESS_KEY=minioadmin
SOURCE_SECRET_KEY=minioadmin
SOURCE_PROVIDER=Minio
SOURCE_REGION=

TARGET_URL=http://minio-b:9000
TARGET_ACCESS_KEY=minioadmin
TARGET_SECRET_KEY=minioadmin
TARGET_PROVIDER=Minio
TARGET_REGION=

# https in the URL turns TLS on by itself. There is no isSecure setting.
# SOURCE_PROVIDER / TARGET_PROVIDER: Minio, Ceph or Other.

# --- What your laptop connects to --------------------------------------
# Used by 'make seed' and 'make verify', which run outside the containers.
# With the lab that means the published ports. With your own servers this
# is usually the same URL as above.

SOURCE_URL_LOCAL=http://localhost:9000
TARGET_URL_LOCAL=http://localhost:9002

# --- Migration ---------------------------------------------------------

# Bucket handled by 'make repl' and 'make verify'. 'all' (the default) means
# every bucket on the source; a name restricts both to that one bucket.
# 'make seed' always creates migration-test.
BUCKET=all

# How deep 'make verify' checks: 1 = names, sizes and ETags; 2 = also
# content type, metadata and tags (default); 3 = also SHA-256 of every
# object, which downloads all data from both sides.
VERIFY_LEVEL=2

# Name of the credentials key inside the Chorus config. It is a label, not
# an S3 user. 'chorctl -u' must use the same name.
CHORUS_USER=user1
